PROJECT_NAME           = "10d_game"
PROJECT_BRIEF          = "C API documentation for 10d_game"
OUTPUT_DIRECTORY       = build

INPUT                  = mainpage.md ../10d_game.h
USE_MDFILE_AS_MAINPAGE = mainpage.md

FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = ..

WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

QUIET                  = NO
